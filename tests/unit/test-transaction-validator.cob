      *****************************************************************
      * TTXNVAL - unit tests for TXNVALID
      *           (src/transaction-validator.cob)
      *
      * Every case starts from the same known-good record
      * (1000-BUILD-GOOD-RECORD), changes one thing, and checks the
      * status code TXNVALID returns.  The fields TXNREAD would have
      * set (raw length, unprintable flag) are set by the test.
      *
      * Control parameters used throughout:
      *   batch date 2026-01-15, maximum backdate 5 days,
      *   deposit limit 1,000.00, withdrawal limit 500.00,
      *   transfer limit 750.00
      *****************************************************************
       IDENTIFICATION DIVISION.
       PROGRAM-ID. TTXNVAL.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY "test-harness-ws.cpy".
       COPY "transaction-record.cpy".
       COPY "batch-control.cpy".
       COPY "txn-work.cpy".

       01  WS-EXPECTED-CODE                PIC X(4).
       01  WS-DATE-TEXT                    PIC X(8).
       01  WS-VALID-FLAG                   PIC X(1).
       01  WS-DAY-NUMBER                   PIC 9(8) BINARY.

       PROCEDURE DIVISION.
       0000-RUN-TESTS.
           MOVE "TRANSACTION VALIDATOR" TO TH-SUITE-NAME
           PERFORM 0100-SET-CONTROL
           PERFORM 2000-ACCEPTED-CASES
           PERFORM 3000-RECORD-SHAPE-CASES
           PERFORM 4000-IDENTITY-CASES
           PERFORM 5000-ACCOUNT-CASES
           PERFORM 6000-AMOUNT-CASES
           PERFORM 7000-DATE-WINDOW-CASES
           PERFORM 8000-LIMIT-CASES
           PERFORM 8500-PRECEDENCE-CASES
           PERFORM TH-FINISH
           STOP RUN.

       0100-SET-CONTROL.
           MOVE "UNITTEST" TO BC-BATCH-ID
           MOVE 20260115 TO BC-BATCH-DATE
           MOVE "20260115" TO WS-DATE-TEXT
           CALL "DATEVAL" USING WS-DATE-TEXT
                                WS-VALID-FLAG
                                WS-DAY-NUMBER
           MOVE WS-DAY-NUMBER TO BC-BATCH-DAY-NUMBER
           MOVE 1000.00 TO BC-MAX-DEPOSIT
           MOVE 500.00 TO BC-MAX-WITHDRAWAL
           MOVE 750.00 TO BC-MAX-TRANSFER
           MOVE 99999999999.99 TO BC-DAILY-DEBIT-LIMIT
           MOVE ZERO TO BC-OVERDRAFT-LIMIT
           MOVE 5 TO BC-MAX-BACKDATE-DAYS
           MOVE "0000000000" TO BC-CLEARING-ACCOUNT.

      *    A valid 80-byte deposit of 123.45.
       1000-BUILD-GOOD-RECORD.
           MOVE SPACES TO TXN-INPUT-AREA
           MOVE "UNIT00000001"  TO TXN-ID
           MOVE "20260115"      TO TXN-DATE
           MOVE "D"             TO TXN-TYPE
           MOVE "1000000001"    TO TXN-ACCOUNT
           MOVE SPACES          TO TXN-CONTRA-ACCOUNT
           MOVE "0000000012345" TO TXN-AMOUNT
           MOVE "UNIT TEST RECORD"  TO TXN-DESCRIPTION
           INITIALIZE TXN-WORK-AREA
           MOVE 1 TO TW-RECORD-NUMBER
           MOVE 70 TO TW-RAW-LENGTH
           MOVE "N" TO TW-UNPRINTABLE-FLAG.

       1100-MAKE-IT-A-TRANSFER.
           MOVE "T" TO TXN-TYPE
           MOVE "1000000002" TO TXN-CONTRA-ACCOUNT.

       1900-RUN-CASE.
           CALL "TXNVALID" USING TXN-INPUT-AREA
                                 BATCH-CONTROL
                                 TXN-WORK-AREA
           MOVE WS-EXPECTED-CODE TO TH-EXPECTED-TEXT
           MOVE TW-STATUS-CODE TO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT.

      *---------------------------------------------------------------
       2000-ACCEPTED-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "VALID DEPOSIT IS ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           MOVE "AMOUNT 0000000012345 IS 123.45" TO TH-CASE-NAME
           MOVE 123.45 TO TH-EXPECTED-NUMBER
           MOVE TW-AMOUNT TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "FIELDS ARE COPIED TO THE WORK AREA" TO TH-CASE-NAME
           MOVE "UNIT00000001/20260115/D/1000000001"
             TO TH-EXPECTED-TEXT
           MOVE SPACES TO TH-ACTUAL-TEXT
           STRING TW-TXN-ID "/" TW-TXN-DATE "/" TW-TXN-TYPE "/"
                  TW-ACCOUNT
               DELIMITED BY SIZE INTO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "W" TO TXN-TYPE
           MOVE "VALID WITHDRAWAL IS ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           PERFORM 1100-MAKE-IT-A-TRANSFER
           MOVE "VALID TRANSFER IS ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0123456789AZ" TO TXN-ID
           MOVE "ID OF DIGITS AND LETTERS IS ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "9999999999999" TO TXN-AMOUNT
           MOVE 99999999999.99 TO BC-MAX-DEPOSIT
           MOVE "LARGEST AMOUNT IS ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE
           MOVE "LARGEST AMOUNT VALUE IS EXACT" TO TH-CASE-NAME
           MOVE 99999999999.99 TO TH-EXPECTED-NUMBER
           MOVE TW-AMOUNT TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER
           MOVE 1000.00 TO BC-MAX-DEPOSIT

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000000001" TO TXN-AMOUNT
           MOVE "ONE CENT IS ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE.

      *---------------------------------------------------------------
       3000-RECORD-SHAPE-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "Y" TO TW-UNPRINTABLE-FLAG
           MOVE "UNPRINTABLE CHARACTERS: V014" TO TH-CASE-NAME
           MOVE "V014" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE 81 TO TW-RAW-LENGTH
           MOVE "LENGTH 81: V002" TO TH-CASE-NAME
           MOVE "V002" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE 80 TO TW-RAW-LENGTH
           MOVE "LENGTH 80: ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE 53 TO TW-RAW-LENGTH
           MOVE "LENGTH 53: V001" TO TH-CASE-NAME
           MOVE "V001" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACES TO TXN-DESCRIPTION
           MOVE 54 TO TW-RAW-LENGTH
           MOVE "LENGTH 54, NO DESCRIPTION: ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACES TO TXN-INPUT-AREA
           MOVE ZERO TO TW-RAW-LENGTH
           MOVE "BLANK RECORD: V001" TO TH-CASE-NAME
           MOVE "V001" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE.

      *---------------------------------------------------------------
       4000-IDENTITY-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "unit00000001" TO TXN-ID
           MOVE "LOWER-CASE ID: V003" TO TH-CASE-NAME
           MOVE "V003" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "UNIT 0000001" TO TXN-ID
           MOVE "SPACE INSIDE ID: V003" TO TH-CASE-NAME
           MOVE "V003" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "UNIT0000001 " TO TXN-ID
           MOVE "ID ONE CHARACTER SHORT: V003" TO TH-CASE-NAME
           MOVE "V003" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "UNIT-0000001" TO TXN-ID
           MOVE "HYPHEN IN ID: V003" TO TH-CASE-NAME
           MOVE "V003" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACES TO TXN-ID
           MOVE "BLANK ID: V003" TO TH-CASE-NAME
           MOVE "V003" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "X" TO TXN-TYPE
           MOVE "TYPE X: V006" TO TH-CASE-NAME
           MOVE "V006" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "d" TO TXN-TYPE
           MOVE "LOWER-CASE TYPE: V006" TO TH-CASE-NAME
           MOVE "V006" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACE TO TXN-TYPE
           MOVE "BLANK TYPE: V006" TO TH-CASE-NAME
           MOVE "V006" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "2026011X" TO TXN-DATE
           MOVE "LETTER IN DATE: V004" TO TH-CASE-NAME
           MOVE "V004" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACES TO TXN-DATE
           MOVE "BLANK DATE: V004" TO TH-CASE-NAME
           MOVE "V004" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20260230" TO TXN-DATE
           MOVE "30 FEBRUARY: V005" TO TH-CASE-NAME
           MOVE "V005" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20261301" TO TXN-DATE
           MOVE "MONTH 13: V005" TO TH-CASE-NAME
           MOVE "V005" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE.

      *---------------------------------------------------------------
       5000-ACCOUNT-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "10000000AB" TO TXN-ACCOUNT
           MOVE "LETTERS IN ACCOUNT: V007" TO TH-CASE-NAME
           MOVE "V007" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "100000001 " TO TXN-ACCOUNT
           MOVE "NINE-DIGIT ACCOUNT: V007" TO TH-CASE-NAME
           MOVE "V007" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACES TO TXN-ACCOUNT
           MOVE "BLANK ACCOUNT: V007" TO TH-CASE-NAME
           MOVE "V007" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000000" TO TXN-ACCOUNT
           MOVE "RESERVED ACCOUNT: V013" TO TH-CASE-NAME
           MOVE "V013" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "1000000002" TO TXN-CONTRA-ACCOUNT
           MOVE "DESTINATION ON A DEPOSIT: V009" TO TH-CASE-NAME
           MOVE "V009" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "W" TO TXN-TYPE
           MOVE "1000000002" TO TXN-CONTRA-ACCOUNT
           MOVE "DESTINATION ON A WITHDRAWAL: V009" TO TH-CASE-NAME
           MOVE "V009" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           PERFORM 1100-MAKE-IT-A-TRANSFER
           MOVE SPACES TO TXN-CONTRA-ACCOUNT
           MOVE "TRANSFER WITH NO DESTINATION: V008" TO TH-CASE-NAME
           MOVE "V008" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           PERFORM 1100-MAKE-IT-A-TRANSFER
           MOVE "ABCDEFGHIJ" TO TXN-CONTRA-ACCOUNT
           MOVE "LETTERS IN DESTINATION: V008" TO TH-CASE-NAME
           MOVE "V008" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           PERFORM 1100-MAKE-IT-A-TRANSFER
           MOVE "0000000000" TO TXN-CONTRA-ACCOUNT
           MOVE "RESERVED DESTINATION: V013" TO TH-CASE-NAME
           MOVE "V013" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           PERFORM 1100-MAKE-IT-A-TRANSFER
           MOVE "1000000001" TO TXN-CONTRA-ACCOUNT
           MOVE "TRANSFER TO THE SAME ACCOUNT: V012" TO TH-CASE-NAME
           MOVE "V012" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE.

      *---------------------------------------------------------------
       6000-AMOUNT-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "00000000123.4" TO TXN-AMOUNT
           MOVE "DECIMAL POINT IN AMOUNT: V010" TO TH-CASE-NAME
           MOVE "V010" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           MOVE "REJECTED AMOUNT IS RETURNED AS ZERO" TO TH-CASE-NAME
           MOVE ZERO TO TH-EXPECTED-NUMBER
           MOVE TW-AMOUNT TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "REJECTED AMOUNT TEXT IS KEPT FOR THE REPORT"
             TO TH-CASE-NAME
           MOVE "00000000123.4" TO TH-EXPECTED-TEXT
           MOVE TW-AMOUNT-TEXT TO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "        12345" TO TXN-AMOUNT
           MOVE "SPACE-PADDED AMOUNT: V010" TO TH-CASE-NAME
           MOVE "V010" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "-000000012345" TO TXN-AMOUNT
           MOVE "SIGNED AMOUNT: V010" TO TH-CASE-NAME
           MOVE "V010" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACES TO TXN-AMOUNT
           MOVE "BLANK AMOUNT: V010" TO TH-CASE-NAME
           MOVE "V010" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000000000" TO TXN-AMOUNT
           MOVE "ZERO AMOUNT: V011" TO TH-CASE-NAME
           MOVE "V011" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE.

      *---------------------------------------------------------------
       7000-DATE-WINDOW-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20260116" TO TXN-DATE
           MOVE "ONE DAY AFTER BATCH DATE: B001" TO TH-CASE-NAME
           MOVE "B001" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20270115" TO TXN-DATE
           MOVE "ONE YEAR AFTER BATCH DATE: B001" TO TH-CASE-NAME
           MOVE "B001" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20260110" TO TXN-DATE
           MOVE "EXACTLY MAX-BACKDATE-DAYS OLD: ACCEPTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20260109" TO TXN-DATE
           MOVE "ONE DAY OLDER THAN ALLOWED: B002" TO TH-CASE-NAME
           MOVE "B002" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20251231" TO TXN-DATE
           MOVE "PREVIOUS YEAR: B002" TO TH-CASE-NAME
           MOVE "B002" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           MOVE ZERO TO BC-MAX-BACKDATE-DAYS
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20260114" TO TXN-DATE
           MOVE "BACKDATING OFF, YESTERDAY: B002" TO TH-CASE-NAME
           MOVE "B002" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "BACKDATING OFF, TODAY: ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE
           MOVE 5 TO BC-MAX-BACKDATE-DAYS.

      *---------------------------------------------------------------
       8000-LIMIT-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000100000" TO TXN-AMOUNT
           MOVE "DEPOSIT EQUAL TO LIMIT: ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000100001" TO TXN-AMOUNT
           MOVE "DEPOSIT ONE CENT OVER LIMIT: B003" TO TH-CASE-NAME
           MOVE "B003" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "W" TO TXN-TYPE
           MOVE "0000000050000" TO TXN-AMOUNT
           MOVE "WITHDRAWAL EQUAL TO LIMIT: ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "W" TO TXN-TYPE
           MOVE "0000000050001" TO TXN-AMOUNT
           MOVE "WITHDRAWAL ONE CENT OVER LIMIT: B004"
             TO TH-CASE-NAME
           MOVE "B004" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           PERFORM 1100-MAKE-IT-A-TRANSFER
           MOVE "0000000075000" TO TXN-AMOUNT
           MOVE "TRANSFER EQUAL TO LIMIT: ACCEPTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           PERFORM 1100-MAKE-IT-A-TRANSFER
           MOVE "0000000075001" TO TXN-AMOUNT
           MOVE "TRANSFER ONE CENT OVER LIMIT: B005" TO TH-CASE-NAME
           MOVE "B005" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

      *    Each limit applies only to its own transaction type.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000075000" TO TXN-AMOUNT
           MOVE "DEPOSIT ABOVE THE WITHDRAWAL LIMIT: ACCEPTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE.

      *    When a record has several faults, the documented order of
      *    checks decides which one is reported.
       8500-PRECEDENCE-CASES.
           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "Y" TO TW-UNPRINTABLE-FLAG
           MOVE 95 TO TW-RAW-LENGTH
           MOVE "UNPRINTABLE BEFORE TOO LONG" TO TH-CASE-NAME
           MOVE "V014" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "bad id" TO TXN-ID
           MOVE "X" TO TXN-TYPE
           MOVE "ID BEFORE TYPE" TO TH-CASE-NAME
           MOVE "V003" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "X" TO TXN-TYPE
           MOVE "20260230" TO TXN-DATE
           MOVE "TYPE BEFORE DATE" TO TH-CASE-NAME
           MOVE "V006" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "20260230" TO TXN-DATE
           MOVE SPACES TO TXN-ACCOUNT
           MOVE "DATE BEFORE ACCOUNT" TO TH-CASE-NAME
           MOVE "V005" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE SPACES TO TXN-ACCOUNT
           MOVE SPACES TO TXN-AMOUNT
           MOVE "ACCOUNT BEFORE AMOUNT" TO TH-CASE-NAME
           MOVE "V007" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000000000" TO TXN-AMOUNT
           MOVE "20260116" TO TXN-DATE
           MOVE "ZERO AMOUNT BEFORE FUTURE DATE" TO TH-CASE-NAME
           MOVE "V011" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE

           PERFORM 1000-BUILD-GOOD-RECORD
           MOVE "0000000100001" TO TXN-AMOUNT
           MOVE "20260116" TO TXN-DATE
           MOVE "FUTURE DATE BEFORE AMOUNT LIMIT" TO TH-CASE-NAME
           MOVE "B001" TO WS-EXPECTED-CODE
           PERFORM 1900-RUN-CASE.

       COPY "test-harness-pd.cpy".

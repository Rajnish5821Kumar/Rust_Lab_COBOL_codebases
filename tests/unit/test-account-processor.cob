      *****************************************************************
      * TACCTPRC - unit tests for ACCTPROC
      *            (src/account-processor.cob)
      *
      * Builds a small account table in memory, posts transactions
      * to it and checks the status code, the balances, the journal
      * entries described in POSTING-RESULT and, for every refused
      * transaction, that nothing at all was changed.
      *
      * Table used by every case (1000-BUILD-TABLE):
      *   1000000001  active   1,000.00
      *   1000000002  active       0.00
      *   1000000003  frozen     500.00
      *   1000000004  closed       0.00
      *   1000000005  active   9,999,999,999,999.99  (largest held)
      *   1000000006  active   5,000.00
      *****************************************************************
       IDENTIFICATION DIVISION.
       PROGRAM-ID. TACCTPRC.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY "test-harness-ws.cpy".
       COPY "batch-control.cpy".
       COPY "txn-work.cpy".
       COPY "posting-result.cpy".
       COPY "account-table.cpy" REPLACING ==:AT:== BY ==AT==.

       01  WS-EXPECTED-CODE                PIC X(4).
       01  WS-ENTRY-NUMBER                 PIC 9(8) BINARY.
       01  WS-BALANCE-SUM                  PIC S9(15)V99
                                           PACKED-DECIMAL.
       01  WS-SUM-BEFORE                   PIC S9(15)V99
                                           PACKED-DECIMAL.

       PROCEDURE DIVISION.
       0000-RUN-TESTS.
           MOVE "ACCOUNT PROCESSOR" TO TH-SUITE-NAME
           PERFORM 2000-DEPOSIT-CASES
           PERFORM 3000-WITHDRAWAL-CASES
           PERFORM 4000-TRANSFER-CASES
           PERFORM 5000-ACCOUNT-STATE-CASES
           PERFORM 6000-OVERFLOW-CASES
           PERFORM 7000-OVERDRAFT-CASES
           PERFORM 8000-DAILY-LIMIT-CASES
           PERFORM 8500-LEDGER-INVARIANT-CASE
           PERFORM TH-FINISH
           STOP RUN.

      *---------------------------------------------------------------
      * Fixtures and helpers
      *---------------------------------------------------------------
       1000-BUILD-TABLE.
           MOVE "UNITTEST" TO BC-BATCH-ID
           MOVE 20260115 TO BC-BATCH-DATE
           MOVE 99999999999.99 TO BC-MAX-DEPOSIT
           MOVE 99999999999.99 TO BC-MAX-WITHDRAWAL
           MOVE 99999999999.99 TO BC-MAX-TRANSFER
           MOVE 99999999999.99 TO BC-DAILY-DEBIT-LIMIT
           MOVE ZERO TO BC-OVERDRAFT-LIMIT
           MOVE 5 TO BC-MAX-BACKDATE-DAYS
           MOVE "0000000000" TO BC-CLEARING-ACCOUNT

           MOVE 6 TO AT-ACCOUNT-COUNT
           MOVE ZERO TO AT-TOTAL-BALANCE
           MOVE ZERO TO AT-CLEARING-POSITION
           PERFORM VARYING WS-ENTRY-NUMBER FROM 1 BY 1
                   UNTIL WS-ENTRY-NUMBER > 6
               MOVE "TEST ACCOUNT" TO AT-ACCT-NAME (WS-ENTRY-NUMBER)
               MOVE "A" TO AT-ACCT-STATUS (WS-ENTRY-NUMBER)
               MOVE ZERO TO AT-BALANCE (WS-ENTRY-NUMBER)
               MOVE ZERO TO AT-DEBIT-TODAY (WS-ENTRY-NUMBER)
           END-PERFORM
           MOVE "1000000001" TO AT-ACCT-ID (1)
           MOVE 1000.00 TO AT-BALANCE (1)
           MOVE "1000000002" TO AT-ACCT-ID (2)
           MOVE "1000000003" TO AT-ACCT-ID (3)
           MOVE "F" TO AT-ACCT-STATUS (3)
           MOVE 500.00 TO AT-BALANCE (3)
           MOVE "1000000004" TO AT-ACCT-ID (4)
           MOVE "C" TO AT-ACCT-STATUS (4)
           MOVE "1000000005" TO AT-ACCT-ID (5)
           MOVE 9999999999999.99 TO AT-BALANCE (5)
           MOVE "1000000006" TO AT-ACCT-ID (6)
           MOVE 5000.00 TO AT-BALANCE (6).

       1100-BUILD-TRANSACTION.
           INITIALIZE TXN-WORK-AREA
           MOVE 1 TO TW-RECORD-NUMBER
           MOVE "UNIT00000001" TO TW-TXN-ID
           MOVE "20260115" TO TW-TXN-DATE
           MOVE "D" TO TW-TXN-TYPE
           MOVE "1000000001" TO TW-ACCOUNT
           MOVE SPACES TO TW-CONTRA-ACCOUNT
           MOVE ZERO TO TW-AMOUNT
           MOVE "0000" TO TW-STATUS-CODE.

       1200-SUM-BALANCES.
           MOVE ZERO TO WS-BALANCE-SUM
           PERFORM VARYING WS-ENTRY-NUMBER FROM 1 BY 1
                   UNTIL WS-ENTRY-NUMBER > AT-ACCOUNT-COUNT
               ADD AT-BALANCE (WS-ENTRY-NUMBER) TO WS-BALANCE-SUM
               ADD AT-DEBIT-TODAY (WS-ENTRY-NUMBER) TO WS-BALANCE-SUM
           END-PERFORM
           ADD AT-CLEARING-POSITION TO WS-BALANCE-SUM.

      *    Posts the transaction and checks the status code.  The sum
      *    of every figure in the table is taken first so a refusal
      *    can be shown to have changed nothing (1910).
       1900-POST-AND-CHECK-CODE.
           PERFORM 1200-SUM-BALANCES
           MOVE WS-BALANCE-SUM TO WS-SUM-BEFORE
           CALL "ACCTPROC" USING BATCH-CONTROL
                                 TXN-WORK-AREA
                                 AT-ACCOUNT-TABLE
                                 POSTING-RESULT
           MOVE WS-EXPECTED-CODE TO TH-EXPECTED-TEXT
           MOVE TW-STATUS-CODE TO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT.

      *    The case name is left as it is: a failure here is reported
      *    under the name of the refusal being tested.
       1910-CHECK-NOTHING-CHANGED.
           PERFORM 1200-SUM-BALANCES
           MOVE WS-SUM-BEFORE TO TH-EXPECTED-NUMBER
           MOVE WS-BALANCE-SUM TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER
           MOVE ZERO TO TH-EXPECTED-NUMBER
           MOVE PR-ENTRY-COUNT TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER.

      *    Posts a transaction that must be refused with the code in
      *    WS-EXPECTED-CODE and must leave the table untouched.
       1950-EXPECT-REFUSAL.
           PERFORM 1900-POST-AND-CHECK-CODE
           PERFORM 1910-CHECK-NOTHING-CHANGED.

      *---------------------------------------------------------------
       2000-DEPOSIT-CASES.
           PERFORM 1000-BUILD-TABLE
           PERFORM 1100-BUILD-TRANSACTION
           MOVE 250.00 TO TW-AMOUNT
           MOVE "DEPOSIT 250.00 IS POSTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE

           MOVE "DEPOSIT RAISES THE BALANCE TO 1,250.00"
             TO TH-CASE-NAME
           MOVE 1250.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "DEPOSIT DEBITS CLEARING: POSITION 250.00"
             TO TH-CASE-NAME
           MOVE 250.00 TO TH-EXPECTED-NUMBER
           MOVE AT-CLEARING-POSITION TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "DEPOSIT DOES NOT COUNT AS A DEBIT TODAY"
             TO TH-CASE-NAME
           MOVE ZERO TO TH-EXPECTED-NUMBER
           MOVE AT-DEBIT-TODAY (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "DEPOSIT ENTRY 1 IS DR CLEARING" TO TH-CASE-NAME
           MOVE "0000000000/DR/1000000001" TO TH-EXPECTED-TEXT
           MOVE SPACES TO TH-ACTUAL-TEXT
           STRING PR-ACCOUNT (1) "/" PR-SIDE (1) "/" PR-CONTRA (1)
               DELIMITED BY SIZE INTO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

           MOVE "DEPOSIT ENTRY 2 IS CR CUSTOMER" TO TH-CASE-NAME
           MOVE "1000000001/CR/0000000000" TO TH-EXPECTED-TEXT
           MOVE SPACES TO TH-ACTUAL-TEXT
           STRING PR-ACCOUNT (2) "/" PR-SIDE (2) "/" PR-CONTRA (2)
               DELIMITED BY SIZE INTO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

           MOVE "DEPOSIT ENTRY AMOUNTS ARE EQUAL" TO TH-CASE-NAME
           MOVE PR-AMOUNT (1) TO TH-EXPECTED-NUMBER
           MOVE PR-AMOUNT (2) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "DEPOSIT ENTRY 2 BALANCE-AFTER IS 1,250.00"
             TO TH-CASE-NAME
           MOVE 1250.00 TO TH-EXPECTED-NUMBER
           MOVE PR-BALANCE-AFTER (2) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "DEPOSIT WRITES TWO ENTRIES" TO TH-CASE-NAME
           MOVE 2 TO TH-EXPECTED-NUMBER
           MOVE PR-ENTRY-COUNT TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER.

      *---------------------------------------------------------------
       3000-WITHDRAWAL-CASES.
           PERFORM 1000-BUILD-TABLE
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE 400.00 TO TW-AMOUNT
           MOVE "WITHDRAWAL 400.00 IS POSTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE

           MOVE "WITHDRAWAL LOWERS THE BALANCE TO 600.00"
             TO TH-CASE-NAME
           MOVE 600.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "WITHDRAWAL CREDITS CLEARING: POSITION -400.00"
             TO TH-CASE-NAME
           MOVE -400.00 TO TH-EXPECTED-NUMBER
           MOVE AT-CLEARING-POSITION TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "WITHDRAWAL COUNTS AS A DEBIT TODAY" TO TH-CASE-NAME
           MOVE 400.00 TO TH-EXPECTED-NUMBER
           MOVE AT-DEBIT-TODAY (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "WITHDRAWAL ENTRY 1 IS DR CUSTOMER" TO TH-CASE-NAME
           MOVE "1000000001/DR/0000000000" TO TH-EXPECTED-TEXT
           MOVE SPACES TO TH-ACTUAL-TEXT
           STRING PR-ACCOUNT (1) "/" PR-SIDE (1) "/" PR-CONTRA (1)
               DELIMITED BY SIZE INTO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

           MOVE "WITHDRAWAL ENTRY 2 IS CR CLEARING" TO TH-CASE-NAME
           MOVE "0000000000/CR/1000000001" TO TH-EXPECTED-TEXT
           MOVE SPACES TO TH-ACTUAL-TEXT
           STRING PR-ACCOUNT (2) "/" PR-SIDE (2) "/" PR-CONTRA (2)
               DELIMITED BY SIZE INTO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

      *    600.00 is left.  One cent more than that must be refused.
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE 600.01 TO TW-AMOUNT
           MOVE "WITHDRAWAL ONE CENT OVER BALANCE: B012"
             TO TH-CASE-NAME
           MOVE "B012" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE 600.00 TO TW-AMOUNT
           MOVE "WITHDRAWAL OF THE WHOLE BALANCE IS POSTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE
           MOVE "BALANCE IS THEN EXACTLY ZERO" TO TH-CASE-NAME
           MOVE ZERO TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE 0.01 TO TW-AMOUNT
           MOVE "WITHDRAWAL FROM A ZERO BALANCE: B012"
             TO TH-CASE-NAME
           MOVE "B012" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE 99999999999.99 TO TW-AMOUNT
           MOVE "LARGEST WITHDRAWAL FROM A ZERO BALANCE: B012"
             TO TH-CASE-NAME
           MOVE "B012" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL.

      *---------------------------------------------------------------
       4000-TRANSFER-CASES.
           PERFORM 1000-BUILD-TABLE
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000002" TO TW-CONTRA-ACCOUNT
           MOVE 300.00 TO TW-AMOUNT
           MOVE "TRANSFER 300.00 IS POSTED" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE

           MOVE "TRANSFER LOWERS THE SOURCE TO 700.00"
             TO TH-CASE-NAME
           MOVE 700.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "TRANSFER RAISES THE DESTINATION TO 300.00"
             TO TH-CASE-NAME
           MOVE 300.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (2) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "TRANSFER DOES NOT TOUCH CLEARING" TO TH-CASE-NAME
           MOVE ZERO TO TH-EXPECTED-NUMBER
           MOVE AT-CLEARING-POSITION TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "TRANSFER COUNTS AS A DEBIT TODAY FOR THE SOURCE"
             TO TH-CASE-NAME
           MOVE 300.00 TO TH-EXPECTED-NUMBER
           MOVE AT-DEBIT-TODAY (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "TRANSFER IS NOT A DEBIT FOR THE DESTINATION"
             TO TH-CASE-NAME
           MOVE ZERO TO TH-EXPECTED-NUMBER
           MOVE AT-DEBIT-TODAY (2) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "TRANSFER ENTRY 1 IS DR SOURCE" TO TH-CASE-NAME
           MOVE "1000000001/DR/1000000002" TO TH-EXPECTED-TEXT
           MOVE SPACES TO TH-ACTUAL-TEXT
           STRING PR-ACCOUNT (1) "/" PR-SIDE (1) "/" PR-CONTRA (1)
               DELIMITED BY SIZE INTO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

           MOVE "TRANSFER ENTRY 2 IS CR DESTINATION" TO TH-CASE-NAME
           MOVE "1000000002/CR/1000000001" TO TH-EXPECTED-TEXT
           MOVE SPACES TO TH-ACTUAL-TEXT
           STRING PR-ACCOUNT (2) "/" PR-SIDE (2) "/" PR-CONTRA (2)
               DELIMITED BY SIZE INTO TH-ACTUAL-TEXT
           PERFORM TH-CHECK-TEXT

           MOVE "TRANSFER DEBIT AND CREDIT ARE EQUAL" TO TH-CASE-NAME
           MOVE PR-AMOUNT (1) TO TH-EXPECTED-NUMBER
           MOVE PR-AMOUNT (2) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE "TRANSFER ENTRY BALANCES ARE 700.00 AND 300.00"
             TO TH-CASE-NAME
           MOVE 1000.00 TO TH-EXPECTED-NUMBER
           COMPUTE TH-ACTUAL-NUMBER =
               PR-BALANCE-AFTER (1) + PR-BALANCE-AFTER (2)
           PERFORM TH-CHECK-NUMBER

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000002" TO TW-CONTRA-ACCOUNT
           MOVE 700.01 TO TW-AMOUNT
           MOVE "TRANSFER ONE CENT OVER BALANCE: B012"
             TO TH-CASE-NAME
           MOVE "B012" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL.

      *---------------------------------------------------------------
       5000-ACCOUNT-STATE-CASES.
           PERFORM 1000-BUILD-TABLE

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "9999999999" TO TW-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "ACCOUNT ABOVE THE LAST ENTRY: B008" TO TH-CASE-NAME
           MOVE "B008" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "0000000001" TO TW-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "ACCOUNT BELOW THE FIRST ENTRY: B008" TO TH-CASE-NAME
           MOVE "B008" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000099" TO TW-CONTRA-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "UNKNOWN TRANSFER DESTINATION: B009" TO TH-CASE-NAME
           MOVE "B009" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "1000000003" TO TW-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "DEPOSIT TO A FROZEN ACCOUNT: B010" TO TH-CASE-NAME
           MOVE "B010" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000003" TO TW-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "WITHDRAWAL FROM A FROZEN ACCOUNT: B010"
             TO TH-CASE-NAME
           MOVE "B010" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "1000000004" TO TW-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "DEPOSIT TO A CLOSED ACCOUNT: B010" TO TH-CASE-NAME
           MOVE "B010" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000003" TO TW-CONTRA-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "TRANSFER TO A FROZEN ACCOUNT: B011" TO TH-CASE-NAME
           MOVE "B011" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000004" TO TW-CONTRA-ACCOUNT
           MOVE 10.00 TO TW-AMOUNT
           MOVE "TRANSFER TO A CLOSED ACCOUNT: B011" TO TH-CASE-NAME
           MOVE "B011" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

      *    The first and last entries are the edges of the search.
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "1000000006" TO TW-ACCOUNT
           MOVE 1.00 TO TW-AMOUNT
           MOVE "LAST TABLE ENTRY IS FOUND" TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE
           MOVE "LAST TABLE ENTRY IS THE ONE CREDITED"
             TO TH-CASE-NAME
           MOVE 5001.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (6) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           MOVE ZERO TO AT-ACCOUNT-COUNT
           PERFORM 1100-BUILD-TRANSACTION
           MOVE 10.00 TO TW-AMOUNT
           MOVE "EMPTY ACCOUNT TABLE: B008" TO TH-CASE-NAME
           MOVE "B008" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE.

      *---------------------------------------------------------------
       6000-OVERFLOW-CASES.
           PERFORM 1000-BUILD-TABLE

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "1000000005" TO TW-ACCOUNT
           MOVE 0.01 TO TW-AMOUNT
           MOVE "DEPOSIT PAST THE LARGEST BALANCE: B014"
             TO TH-CASE-NAME
           MOVE "B014" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

      *    The source has the funds, so only the destination's
      *    overflow stops this.  The source must not be debited.
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000005" TO TW-CONTRA-ACCOUNT
           MOVE 0.01 TO TW-AMOUNT
           MOVE "TRANSFER INTO A FULL ACCOUNT: B014" TO TH-CASE-NAME
           MOVE "B014" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           MOVE "SOURCE NOT DEBITED WHEN DESTINATION OVERFLOWS"
             TO TH-CASE-NAME
           MOVE 1000.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000005" TO TW-ACCOUNT
           MOVE 0.99 TO TW-AMOUNT
           MOVE "WITHDRAWAL FROM THE LARGEST BALANCE IS POSTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE
           MOVE "LARGEST BALANCE LESS 0.99 IS EXACT" TO TH-CASE-NAME
           MOVE 9999999999999.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (5) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER.

      *---------------------------------------------------------------
       7000-OVERDRAFT-CASES.
           PERFORM 1000-BUILD-TABLE
           MOVE 100.00 TO BC-OVERDRAFT-LIMIT

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000002" TO TW-ACCOUNT
           MOVE 100.00 TO TW-AMOUNT
           MOVE "WITHDRAWAL DOWN TO THE OVERDRAFT FLOOR IS POSTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE
           MOVE "BALANCE IS THEN -100.00" TO TH-CASE-NAME
           MOVE -100.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (2) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER
           MOVE "ENTRY SHOWS THE NEGATIVE BALANCE" TO TH-CASE-NAME
           MOVE -100.00 TO TH-EXPECTED-NUMBER
           MOVE PR-BALANCE-AFTER (1) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000002" TO TW-ACCOUNT
           MOVE 0.01 TO TW-AMOUNT
           MOVE "ONE CENT BELOW THE OVERDRAFT FLOOR: B012"
             TO TH-CASE-NAME
           MOVE "B012" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "1000000002" TO TW-ACCOUNT
           MOVE 40.00 TO TW-AMOUNT
           MOVE "DEPOSIT TO AN OVERDRAWN ACCOUNT IS POSTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE
           MOVE "BALANCE IS THEN -60.00" TO TH-CASE-NAME
           MOVE -60.00 TO TH-EXPECTED-NUMBER
           MOVE AT-BALANCE (2) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER.

      *---------------------------------------------------------------
       8000-DAILY-LIMIT-CASES.
           PERFORM 1000-BUILD-TABLE
           MOVE 1000.00 TO BC-DAILY-DEBIT-LIMIT

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000006" TO TW-ACCOUNT
           MOVE 600.00 TO TW-AMOUNT
           MOVE "FIRST DEBIT WITHIN THE DAILY LIMIT IS POSTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000006" TO TW-ACCOUNT
           MOVE "1000000001" TO TW-CONTRA-ACCOUNT
           MOVE 400.00 TO TW-AMOUNT
           MOVE "TRANSFER REACHING THE DAILY LIMIT IS POSTED"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE
           MOVE "DEBITS TODAY ARE THEN 1,000.00" TO TH-CASE-NAME
           MOVE 1000.00 TO TH-EXPECTED-NUMBER
           MOVE AT-DEBIT-TODAY (6) TO TH-ACTUAL-NUMBER
           PERFORM TH-CHECK-NUMBER

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000006" TO TW-ACCOUNT
           MOVE 0.01 TO TW-AMOUNT
           MOVE "ONE CENT OVER THE DAILY LIMIT: B013" TO TH-CASE-NAME
           MOVE "B013" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000006" TO TW-ACCOUNT
           MOVE "1000000001" TO TW-CONTRA-ACCOUNT
           MOVE 0.01 TO TW-AMOUNT
           MOVE "TRANSFER OVER THE DAILY LIMIT: B013" TO TH-CASE-NAME
           MOVE "B013" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL

      *    The limit is per account: account 1 received 400.00 and
      *    has made no debits of its own.
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE 1000.00 TO TW-AMOUNT
           MOVE "ANOTHER ACCOUNT HAS ITS OWN DAILY LIMIT"
             TO TH-CASE-NAME
           MOVE "0000" TO WS-EXPECTED-CODE
           PERFORM 1900-POST-AND-CHECK-CODE

      *    Funds are checked before the daily limit.
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000002" TO TW-ACCOUNT
           MOVE 5000.00 TO TW-AMOUNT
           MOVE "NO FUNDS AND OVER LIMIT REPORTS FUNDS: B012"
             TO TH-CASE-NAME
           MOVE "B012" TO WS-EXPECTED-CODE
           PERFORM 1950-EXPECT-REFUSAL.

      *---------------------------------------------------------------
      * After any mix of postings, the customer balances must have
      * moved by exactly the clearing position (the invariant that
      * reconciliation check R006 relies on).
      *---------------------------------------------------------------
       8500-LEDGER-INVARIANT-CASE.
           PERFORM 1000-BUILD-TABLE
           PERFORM 1100-BUILD-TRANSACTION
           MOVE 123.45 TO TW-AMOUNT
           CALL "ACCTPROC" USING BATCH-CONTROL TXN-WORK-AREA
                                 AT-ACCOUNT-TABLE POSTING-RESULT
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "W" TO TW-TXN-TYPE
           MOVE "1000000006" TO TW-ACCOUNT
           MOVE 1000.10 TO TW-AMOUNT
           CALL "ACCTPROC" USING BATCH-CONTROL TXN-WORK-AREA
                                 AT-ACCOUNT-TABLE POSTING-RESULT
           PERFORM 1100-BUILD-TRANSACTION
           MOVE "T" TO TW-TXN-TYPE
           MOVE "1000000006" TO TW-ACCOUNT
